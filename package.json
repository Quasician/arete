{
  "name": "arete",
  "productName": "Arete",
  "version": "0.9.1",
  "description": "Arete: a desktop companion to Praxis that measures training, food and weight.",
  "author": "Quasician",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/Quasician/arete",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test --experimental-transform-types --no-warnings tests/*.test.ts",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "release:win": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "@vitejs/plugin-react": "^6.3.0",
    "echarts": "^6.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "zustand": "^5.1.0"
  }
}
